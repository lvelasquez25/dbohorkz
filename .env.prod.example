# Copiar a .env en el VPS y completar. NUNCA commitear el .env real.

# --- Dominio / SSL ---
SITE_DOMAIN=dbohorkz.com
ACME_EMAIL=tu-correo@dominio.com

# --- Base de datos (Postgres en Docker) ---
POSTGRES_DB=dbohorkz
POSTGRES_USER=dbohorkz
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# --- Flask ---
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
FLASK_ENV=production
FLASK_DEBUG=False
CORS_ORIGINS=https://dbohorkz.com,https://www.dbohorkz.com
ADMIN_USERNAME=admin

# --- Imágenes (Cloudinary) — copiar de Railway ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Correo ---
RESEND_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_RECIPIENT=

# --- WhatsApp (acceso a wa.<dominio>/api/qr) ---
WA_USER=admin
# Generar con: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-clave'
# IMPORTANTE: escribir cada $ como $$ (Docker Compose interpreta $ como variable)
WA_PASSWORD_HASH=
TYPING_DELAY=1000

# Opcional
OPENAI_API_KEY=
